/* =========================================
   MOBILE FIRST HEADER STYLES (Default)
   ========================================= */

/* Hamburger Animation when Active */
.navbarContainer.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
}
.navbarContainer.active .bar:nth-child(2) {
    opacity: 0;
}
.navbarContainer.active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
}

/* Mobile Dropdown Menu (.navMenu) */
.navMenu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease-in-out;
    z-index: 1000;
}

.navMenu.active {
    max-height: 300px; /* Expands menu when toggled */
}

.navList {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
}

.navItem {
    margin: 0.8rem 0;
}

.navLink {
    text-decoration: none;
    color: #e2e8f0;
    font-size: 1.1rem;
    transition: color 0.3s ease;
}

.navLink:hover {
    color: #38bdf8;
}
